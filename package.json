{
  "name": "@ahmdrv/sshx",
  "version": "0.3.1",
  "description": "A lightweight terminal SSH manager inspired by Termius, LazyGit, and modern AI CLIs.",
  "type": "module",
  "packageManager": "bun@1.3.1",
  "bin": {
    "sshx": "dist/src/cli/index.js"
  },
  "files": [
    "dist",
    "package.json",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "bun run build && node dist/src/cli/index.js",
    "build": "node scripts/clean.js && tsc -p tsconfig.json",
    "check": "bun run typecheck && bun run lint && bun run test && bun run build",
    "prepack": "bun run check",
    "postinstall": "node scripts/fix-node-pty-permissions.js",
    "start": "node dist/src/cli/index.js",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "ssh",
    "terminal",
    "tui",
    "ink",
    "cli"
  ],
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^12.1.0",
    "fs-extra": "^11.2.0",
    "ink": "^5.0.1",
    "node-pty": "^1.0.0",
    "react": "^18.3.1",
    "yaml": "^2.5.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.11",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "eslint": "^9.11.1",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
